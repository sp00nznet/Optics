# Optics Environment Configuration
# Copy this file to .env and update the values

# ===================
# Database Settings
# ===================
POSTGRES_USER=optics
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=optics

# ===================
# Security Settings
# ===================
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_string_here

# ===================
# Storage Settings
# ===================
# Path to your 3D model files (local path or mount point)
MODELS_PATH=/mnt/3d-models

# ===================
# Optional Settings
# ===================
# Server port overrides
# FRONTEND_PORT=3333
# BACKEND_PORT=8080

# Scanning configuration
# SCAN_EXTENSIONS=stl,scad,obj,3mf,step,stp
